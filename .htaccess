<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Map static assets and media folders directly to dist
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]
  RewriteRule ^images/(.*)$ dist/images/$1 [L]
  RewriteRule ^favicon\.svg$ dist/favicon.svg [L]

  # 2. Serve root path from dist/index.html
  RewriteRule ^$ dist/index.html [L]

  # 3. Single Page App fallback for client-side routing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ dist/index.html [L]
</IfModule>
